{
  "name": "law-office-ui",
  "version": "2.0.0-dev",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "^21.2.26",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@microsoft/signalr": "^10.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@primeng/themes": "^21.0.4",
    "@primeuix/themes": "^2.0.3",
    "@tailwindcss/postcss": "^4.2.4",
    "chart.js": "^4.5.1",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.6",
    "rxjs": "~7.8.0",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.26",
    "autoprefixer": "^10.5.0",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@angular/animations": "$@angular/animations",
    "@angular/common": "$@angular/common",
    "@angular/compiler": "$@angular/compiler",
    "@angular/compiler-cli": "$@angular/compiler-cli",
    "@angular/core": "$@angular/core",
    "@angular/forms": "$@angular/forms",
    "@angular/platform-browser": "$@angular/platform-browser",
    "@angular/router": "$@angular/router",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true
  }
}
